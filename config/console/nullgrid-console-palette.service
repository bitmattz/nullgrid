# The NULLGRID colors on every Linux console (the greeter, TTY mode before login, boot messages
# after the splash). Users' own theme colors are applied at their login on top of this.
# Plymouth restores the palette it found when it quits, so this runs after the splash is gone
# and before anything shows on a console.
[Unit]
Description=NULLGRID console palette
After=systemd-vconsole-setup.service plymouth-quit.service plymouth-quit-wait.service
Before=getty@tty1.service greetd.service
ConditionPathExists=/usr/share/nullgrid/console/vtrgb

[Service]
Type=oneshot
ExecStart=/usr/bin/setvtrgb /usr/share/nullgrid/console/vtrgb
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
