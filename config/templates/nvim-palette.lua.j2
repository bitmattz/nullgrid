{{ header("--") }}
-- require("nullgrid.palette") from the nullgrid colorscheme.

return {
  name = "{{ theme.meta.name }}",
{% for key in ["bg", "bg_alt", "surface", "primary", "secondary", "glow", "text", "dim", "warning"] %}
  {{ key }} = "{{ c[key] }}",
{% endfor %}
  terminal = {
{% for i in range(16) %}
    "{{ t["color" ~ i] }}",
{% endfor %}
  },
  selection = "{{ t.selection }}",
  -- terminal palette slot of each role, for 'notermguicolors' (Linux console)
  ansi = {
{% for role, index in ansi_roles.items() %}
    {{ role }} = {{ index }},
{% endfor %}
  },
  transparent = {{ (style.terminal_opacity < 1) | tf }},
}
