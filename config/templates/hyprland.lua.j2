{{ header("--") }}
-- The look of windows. Loaded by ~/.config/hypr/hyprland.lua, which gets the palette back
-- for its own rules: local ng = ...; ng.primary is "rgba(rrggbbaa)".

hl.config({
    general = {
        border_size = {{ style.border_width }},
        gaps_in = {{ (style.gaps / 2) | round | int }},
        gaps_out = {{ style.gaps }},
        col = {
            -- 2px neon on the active window, a dim line on the others
            active_border = { colors = { "{{ c.glow.hypr() }}", "{{ c.secondary.hypr() }}" }, angle = 45 },
            inactive_border = "{{ c.dim.hypr(0.35) }}",
        },
    },
    decoration = {
        -- Hyprland can't cut corners, so "chamfer" windows are square; panels get the chamfers.
        rounding = {{ 10 if style.corners == "round" else 0 }},
        blur = {
            enabled = {{ effects.blur | tf }},
            size = 6,
            passes = 2,
            new_optimizations = true,
        },
        -- the neon halo around the active window
        glow = {
            enabled = {{ effects.shadows | tf }},
            range = {{ (style.glow * 20) | round | int }},
            render_power = 2,
            color = "{{ c.glow.hypr(style.glow * 0.7) }}",
            color_inactive = "{{ c.bg.hypr(0) }}",
        },
        shadow = { enabled = false },
    },
    animations = { enabled = {{ effects.animations | tf }} },
    -- seen for a moment before the wallpaper is up
    misc = { background_color = "{{ c.bg.hypr() }}" },
})
{% if effects.animations %}

-- Quick, slightly mechanical: fast start, hard stop. Speeds are in deciseconds.
hl.curve("ng_mech", { type = "bezier", points = { {0.2, 0.9}, {0.1, 1.0} } })
hl.curve("ng_snap", { type = "bezier", points = { {0.5, 0.0}, {0.1, 1.0} } })
hl.animation({ leaf = "global", enabled = true, speed = {{ ms(180) / 100 }}, bezier = "ng_mech" })
hl.animation({ leaf = "windowsIn", enabled = true, speed = {{ ms(180) / 100 }}, bezier = "ng_mech", style = "popin 92%" })
hl.animation({ leaf = "windowsOut", enabled = true, speed = {{ ms(120) / 100 }}, bezier = "ng_snap", style = "popin 92%" })
hl.animation({ leaf = "windowsMove", enabled = true, speed = {{ ms(180) / 100 }}, bezier = "ng_mech" })
hl.animation({ leaf = "border", enabled = true, speed = {{ ms(220) / 100 }}, bezier = "ng_mech" })
hl.animation({ leaf = "fade", enabled = true, speed = {{ ms(150) / 100 }}, bezier = "ng_mech" })
hl.animation({ leaf = "layers", enabled = true, speed = {{ ms(150) / 100 }}, bezier = "ng_mech", style = "fade" })
hl.animation({ leaf = "workspaces", enabled = true, speed = {{ ms(200) / 100 }}, bezier = "ng_mech", style = "slide" })
{% endif %}

return {
{% for role in ("bg", "bg_alt", "surface", "primary", "secondary", "glow", "text", "dim", "warning") %}
    {{ role }} = "{{ c[role].hypr() }}",
{% endfor %}
    font_ui = {{ fonts.ui | lua }},
    font_mono = {{ fonts.mono | lua }},
    font_display = {{ fonts.display | lua }},
}
