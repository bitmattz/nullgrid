{{ header("#") }}
# {{ "Linux console variant: only glyphs the console font has, colors from the 16-color palette." if tty else "Desktop variant (kitty): angular powerline segments." }}
"$schema" = "https://starship.rs/config-schema.json"
add_newline = true
{% set P, S, T, D = ansi_roles.primary, ansi_roles.secondary, ansi_roles.text, ansi_roles.dim %}
{% if tty %}
format = '''
[┌─\[](bold {{ P }})$username[@]({{ P }})$hostname[\]─\[](bold {{ P }})$directory[\]](bold {{ P }})$git_branch$git_status$cmd_duration$status
[└─](bold {{ P }})$character'''

[username]
show_always = true
format = "[$user]($style)"
style_user = "bold {{ T }}"
style_root = "bold {{ S }}"

[hostname]
ssh_only = false
format = "[$hostname]($style)"
style = "{{ T }}"

[directory]
format = "[$path]($style)[$read_only]($read_only_style)"
style = "bold {{ P }}"
read_only = " RO"
read_only_style = "{{ S }}"
truncation_length = 3
truncation_symbol = ".../"

[git_branch]
format = "[─\\[](bold {{ P }})[$branch]($style)[\\]](bold {{ P }})"
style = "{{ S }}"

[git_status]
format = "( [$all_status$ahead_behind]($style))"
style = "{{ ansi(c.warning) }}"

[cmd_duration]
min_time = 2000
format = "[─\\[](bold {{ P }})[$duration]($style)[\\]](bold {{ P }})"
style = "{{ ansi(c.warning) }}"

[status]
disabled = false
format = "[─\\[](bold {{ P }})[ERR $status]($style)[\\]](bold {{ P }})"
style = "bold {{ S }}"

[character]
success_symbol = "[»](bold {{ P }})"
error_symbol = "[»](bold {{ S }})"
{% else %}
palette = "nullgrid"
format = '''
[╭─](primary)[](primary)$username$hostname[](fg:primary bg:surface)$directory[](fg:surface bg:bg_alt)$git_branch$git_status[](fg:bg_alt)$cmd_duration$status$fill$time
[╰─](primary)$character'''

[palettes.nullgrid]
{% for key in ["bg", "bg_alt", "surface", "primary", "secondary", "glow", "text", "dim", "warning"] %}
{{ key }} = "{{ c[key] }}"
{% endfor %}

[username]
show_always = true
format = "[ $user]($style)"
style_user = "bg:primary fg:bg bold"
style_root = "bg:secondary fg:bg bold"

[hostname]
ssh_only = false
format = "[@$hostname ]($style)"
style = "bg:primary fg:bg"

[directory]
format = "[ $path]($style)[$read_only]($read_only_style)[ ](bg:surface)"
style = "bg:surface fg:primary bold"
read_only = " RO"
read_only_style = "bg:surface fg:secondary"
truncation_length = 3
truncation_symbol = "…/"

[git_branch]
symbol = " "
format = "[ $symbol$branch ]($style)"
style = "bg:bg_alt fg:secondary"

[git_status]
format = "[$all_status$ahead_behind ]($style)"
style = "bg:bg_alt fg:warning"

[cmd_duration]
min_time = 2000
format = "[ $duration]($style)"
style = "fg:warning"

[status]
disabled = false
format = "[ ERR $status]($style)"
style = "fg:secondary bold"

[fill]
symbol = " "

[time]
disabled = false
time_format = "%H:%M:%S"
format = "[$time]($style)"
style = "fg:dim"

[character]
success_symbol = "[›](bold primary)"
error_symbol = "[›](bold secondary)"
{% endif %}
