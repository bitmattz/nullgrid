{#- Palette for the GTK themes, included by gtk3.css.j2 and gtk4.css.j2. The base theme
    (adw-gtk3) draws everything with these named colors. -#}
{% set view = c.bg.mix(c.bg_alt, 0.35) %}
{% set accent_bg = c.primary.mix(c.bg, 0.2) %}
@define-color ng_bg {{ c.bg }};
@define-color ng_bg_alt {{ c.bg_alt }};
@define-color ng_surface {{ c.surface }};
@define-color ng_primary {{ c.primary }};
@define-color ng_secondary {{ c.secondary }};
@define-color ng_glow {{ c.glow }};
@define-color ng_text {{ c.text }};
@define-color ng_dim {{ c.dim }};
@define-color ng_warning {{ c.warning }};

@define-color accent_color {{ c.primary }};
@define-color accent_bg_color {{ accent_bg }};
@define-color accent_fg_color {{ c.bg }};
@define-color window_bg_color {{ c.bg }};
@define-color window_fg_color {{ c.text }};
@define-color view_bg_color {{ view }};
@define-color view_fg_color {{ c.text }};
@define-color headerbar_bg_color {{ c.surface }};
@define-color headerbar_fg_color {{ c.text }};
@define-color headerbar_backdrop_color {{ c.bg }};
@define-color headerbar_border_color {{ c.primary.mix(c.surface, 0.55) }};
@define-color headerbar_shade_color rgba(0, 0, 0, 0.4);
@define-color headerbar_darker_shade_color rgba(0, 0, 0, 0.5);
@define-color sidebar_bg_color {{ c.surface.mix(c.bg, 0.5) }};
@define-color sidebar_fg_color {{ c.text }};
@define-color sidebar_backdrop_color {{ c.bg }};
@define-color sidebar_border_color {{ c.primary.mix(c.bg, 0.75) }};
@define-color sidebar_shade_color rgba(0, 0, 0, 0.3);
@define-color card_bg_color {{ c.surface }};
@define-color card_fg_color {{ c.text }};
@define-color card_shade_color rgba(0, 0, 0, 0.4);
@define-color dialog_bg_color {{ c.surface }};
@define-color dialog_fg_color {{ c.text }};
@define-color popover_bg_color {{ c.surface }};
@define-color popover_fg_color {{ c.text }};
@define-color popover_shade_color rgba(0, 0, 0, 0.4);
@define-color thumbnail_bg_color {{ c.surface }};
@define-color thumbnail_fg_color {{ c.text }};
@define-color shade_color rgba(0, 0, 0, 0.4);
@define-color scrollbar_outline_color rgba(0, 0, 0, 0.5);
@define-color destructive_color {{ c.secondary }};
@define-color destructive_bg_color {{ c.secondary.mix(c.bg, 0.25) }};
@define-color destructive_fg_color {{ c.text }};
@define-color error_color {{ c.secondary }};
@define-color error_bg_color {{ c.secondary.mix(c.bg, 0.25) }};
@define-color error_fg_color {{ c.text }};
@define-color warning_color {{ c.warning }};
@define-color warning_bg_color {{ c.warning.mix(c.bg, 0.35) }};
@define-color warning_fg_color {{ c.bg }};
@define-color success_color {{ t.color2 }};
@define-color success_bg_color {{ t.color2.mix(c.bg, 0.35) }};
@define-color success_fg_color {{ c.bg }};
@define-color borders {{ c.primary.mix(c.bg, 0.78) }};
@define-color unfocused_borders {{ c.dim.mix(c.bg, 0.6) }};
{% if vars_too is defined and vars_too %}

/* GTK 4.16+ reads the same palette as CSS variables */
:root {
  --accent-color: {{ c.primary }};
  --accent-bg-color: {{ accent_bg }};
  --accent-fg-color: {{ c.bg }};
  --window-bg-color: {{ c.bg }};
  --window-fg-color: {{ c.text }};
  --view-bg-color: {{ view }};
  --view-fg-color: {{ c.text }};
  --headerbar-bg-color: {{ c.surface }};
  --headerbar-fg-color: {{ c.text }};
  --headerbar-backdrop-color: {{ c.bg }};
  --headerbar-border-color: {{ c.primary.mix(c.surface, 0.55) }};
  --sidebar-bg-color: {{ c.surface.mix(c.bg, 0.5) }};
  --sidebar-fg-color: {{ c.text }};
  --sidebar-backdrop-color: {{ c.bg }};
  --sidebar-border-color: {{ c.primary.mix(c.bg, 0.75) }};
  --secondary-sidebar-bg-color: {{ c.surface.mix(c.bg, 0.5) }};
  --secondary-sidebar-fg-color: {{ c.text }};
  --card-bg-color: {{ c.surface }};
  --card-fg-color: {{ c.text }};
  --dialog-bg-color: {{ c.surface }};
  --dialog-fg-color: {{ c.text }};
  --popover-bg-color: {{ c.surface }};
  --popover-fg-color: {{ c.text }};
  --thumbnail-bg-color: {{ c.surface }};
  --thumbnail-fg-color: {{ c.text }};
  --destructive-color: {{ c.secondary }};
  --destructive-bg-color: {{ c.secondary.mix(c.bg, 0.25) }};
  --destructive-fg-color: {{ c.text }};
  --error-color: {{ c.secondary }};
  --error-bg-color: {{ c.secondary.mix(c.bg, 0.25) }};
  --error-fg-color: {{ c.text }};
  --warning-color: {{ c.warning }};
  --warning-bg-color: {{ c.warning.mix(c.bg, 0.35) }};
  --warning-fg-color: {{ c.bg }};
  --success-color: {{ t.color2 }};
  --success-bg-color: {{ t.color2.mix(c.bg, 0.35) }};
  --success-fg-color: {{ c.bg }};
}
{% endif %}
