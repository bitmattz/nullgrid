{#- The NULLGRID look on top of adw-gtk3, shared by the GTK 3 and GTK 4 themes (gtk4 = true/false).
    Square corners (GTK can't cut them; the panels of the shell do), thin neon lines, hatched
    "on" states, segmented progress bars. -#}
{% set r = 6 if style.corners == "round" else 0 %}
{% set g = style.glow %}
{% set hatch = "repeating-linear-gradient(135deg, alpha(@ng_primary, 0.22) 0px, alpha(@ng_primary, 0.22) 2px, transparent 2px, transparent 6px)" %}

/* -- shapes -- */
button, entry, spinbutton, combobox button, menubutton > button, dropdown > button, .linked > button,
popover > contents, popover.background, popover.menu, menu, .menu, .context-menu, tooltip,
frame > border, .frame, list, list.boxed-list, .card, notebook > header tab, notebook > header,
scrollbar slider, progressbar trough, progressbar progress, scale trough, scale highlight, scale fill,
switch, switch slider, check, infobar, .app-notification, toast, textview, row, .view,
headerbar, window, window.csd, decoration, messagedialog, dialog, .dialog-action-area button {
  border-radius: {{ r }}px;
}
{% if not gtk4 %}
* { -gtk-outline-radius: {{ r }}px; }
{% endif %}

/* -- window frame: Hyprland/Sway draw the border and the glow -- */
decoration, decoration:backdrop, window.csd decoration, window.csd decoration:backdrop {
  box-shadow: none;
  border-radius: 0;
}
{% if gtk4 %}
window.csd, window.csd:backdrop { box-shadow: none; outline: none; }
{% endif %}

/* -- header bars: a neon rule underneath, spaced titles -- */
headerbar {
  border-bottom: 1px solid alpha(@ng_primary, 0.45);
  box-shadow: none;
}
headerbar .title, headerbar label.title, .titlebar .title, windowtitle .title {
  font-weight: bold;
  letter-spacing: 2px;
}
headerbar:backdrop { border-bottom-color: alpha(@ng_dim, 0.4); }

/* -- buttons -- */
button:hover:not(:disabled) {
  box-shadow: inset 0 0 0 1px alpha(@ng_primary, 0.55);
}
button:checked, button.toggle:checked, .linked > button:checked {
  background-image: {{ hatch }};
  box-shadow: inset 0 0 0 1px @ng_primary;
  color: @ng_primary;
}
button.suggested-action, button.default {
  box-shadow: 0 0 {{ (g * 10) | round | int }}px alpha(@ng_primary, {{ (g * 0.5) | round(2) }});
}
button.destructive-action {
  box-shadow: 0 0 {{ (g * 10) | round | int }}px alpha(@ng_secondary, {{ (g * 0.5) | round(2) }});
}

/* -- text entries: underlined, glowing when focused -- */
entry, spinbutton:not(.vertical) {
  box-shadow: inset 0 -1px alpha(@ng_primary, 0.35);
}
entry:focus, entry:focus-within, spinbutton:focus-within {
  box-shadow: inset 0 0 0 1px @ng_primary, 0 0 {{ (g * 8) | round | int }}px alpha(@ng_primary, {{ (g * 0.4) | round(2) }});
}

/* -- popups -- */
popover > contents, popover.background > contents, menu, .menu, .context-menu, popover.menu > contents {
  border: 1px solid alpha(@ng_primary, 0.4);
}
tooltip, tooltip.background {
  background-color: @ng_surface;
  border: 1px solid alpha(@ng_primary, 0.5);
  color: @ng_text;
}

/* -- selection: what is picked is hatched, not just filled -- */
row:selected, treeview.view:selected, .view:selected, iconview:selected, gridview > child:selected,
columnview > listview > row:selected, flowboxchild:selected {
  background-image: {{ hatch }};
}
selection, text selection, entry selection, label selection {
  background-color: alpha(@ng_primary, 0.35);
  color: @ng_text;
}

/* -- scrollbars: thin, dim until touched -- */
scrollbar slider {
  min-width: 4px;
  min-height: 4px;
  background-color: alpha(@ng_dim, 0.7);
}
scrollbar slider:hover, scrollbar slider:active { background-color: @ng_primary; }

/* -- bars: segmented, like the shell's gauges -- */
progressbar progress, levelbar block.filled {
  background-color: transparent;
  background-image: repeating-linear-gradient(90deg, @ng_primary 0px, @ng_primary 6px, transparent 6px, transparent 8px);
  border-color: transparent;
}
progressbar trough, levelbar trough { background-color: alpha(@ng_dim, 0.25); }
scale highlight, scale fill { background-color: @ng_primary; }
switch:checked { background-color: alpha(@ng_primary, 0.7); }

/* -- tabs -- */
notebook > header tab:checked {
  box-shadow: inset 0 -2px @ng_primary;
  color: @ng_primary;
}
{% if gtk4 %}
tabbar tab:selected { box-shadow: inset 0 -2px @ng_primary; }
{% endif %}

/* -- links and the odd accent -- */
link, *:link, button.link > label { color: @ng_primary; }
*:visited, link:visited { color: @ng_glow; }
.sidebar row:selected, placessidebar row:selected, stacksidebar row:selected {
  box-shadow: inset 2px 0 @ng_primary;
}
