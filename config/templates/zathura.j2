{{ header("#") }}
# Included by ~/.config/zathura/zathurarc. Ctrl+R flips pages to these colors.

set font "{{ fonts.mono }} {{ fonts.mono_size }}"
set default-bg "{{ c.bg }}"
set default-fg "{{ c.text }}"
set statusbar-bg "{{ c.surface }}"
set statusbar-fg "{{ c.primary }}"
set inputbar-bg "{{ c.bg }}"
set inputbar-fg "{{ c.text }}"
set notification-bg "{{ c.surface }}"
set notification-fg "{{ c.text }}"
set notification-error-bg "{{ c.secondary }}"
set notification-error-fg "{{ c.bg }}"
set notification-warning-bg "{{ c.warning }}"
set notification-warning-fg "{{ c.bg }}"
set highlight-color "{{ c.primary.rgba(0.35) }}"
set highlight-active-color "{{ c.secondary.rgba(0.45) }}"
set completion-bg "{{ c.surface }}"
set completion-fg "{{ c.text }}"
set completion-group-bg "{{ c.bg }}"
set completion-group-fg "{{ c.dim }}"
set completion-highlight-bg "{{ c.primary.mix(c.bg, 0.2) }}"
set completion-highlight-fg "{{ c.bg }}"
set index-bg "{{ c.bg }}"
set index-fg "{{ c.text }}"
set index-active-bg "{{ c.primary.mix(c.bg, 0.2) }}"
set index-active-fg "{{ c.bg }}"
set recolor-lightcolor "{{ c.bg }}"
set recolor-darkcolor "{{ c.text }}"
set render-loading-bg "{{ c.bg }}"
set render-loading-fg "{{ c.dim }}"
