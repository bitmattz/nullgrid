#!/bin/sh
# nullgrid-session [hyprland|sway]
# Start the NULLGRID desktop on this virtual terminal. The tty1 login runs it in desktop mode.
#
# Without an argument: Sway when [performance] profile = "lite", Hyprland otherwise. If the
# compositor quits within 10 s it couldn't start (e.g. on an unsupported GPU), and the next one is
# tried. That goes by time, not exit status: Hyprland reports success even when it gave up at
# startup (seen in VirtualBox). Exit status: 0 the desktop ran and was left; 1 no compositor could start (the login
# shell then falls back to TTY mode); anything else, the desktop crashed after running.
# Last resort before giving up: Sway drawing in pure software (pixman), which needs no working
# GPU driver at all (e.g. VirtualBox without 3D acceleration).
# Compositor output: ~/.local/state/nullgrid/session-<name>.log. What happened at the last start
# is in session-status (`nullgrid doctor` reports it).
set -u

state=${XDG_STATE_HOME:-$HOME/.local/state}/nullgrid
config=${XDG_CONFIG_HOME:-$HOME/.config}
mkdir -p "$state"
if [ -z "${NULLGRID_LITE:-}" ] && [ -r "$config/nullgrid/generated/shell-env.sh" ]; then
    . "$config/nullgrid/generated/shell-env.sh"
fi

fail() { echo "nullgrid-session: $*" >&2; exit 1; }
[ -n "${XDG_RUNTIME_DIR:-}" ] || fail "XDG_RUNTIME_DIR is not set (not logged in through logind?)"
[ -z "${WAYLAND_DISPLAY:-}" ] || fail "already inside a Wayland session"
ls /dev/dri/card* >/dev/null 2>&1 || fail "no display device (/dev/dri/card*)"

# Is there a GPU with 3D? Without one, Mesa draws in software (llvmpipe), every frame costs real
# CPU, and the shell drops its continuous animations (NULLGRID_SOFTWARE_RENDER=1).
software_render() {
    found=0
    for card in /sys/class/drm/card[0-9]*; do
        case ${card##*/} in *-*) continue ;; esac  # connectors, not cards
        dev=$(readlink -f "$card/device") || continue
        found=1
        case $(basename "$(readlink -f "$dev/driver")") in
            simple-framebuffer|simpledrm|efifb|bochs-drm|bochs|cirrus|cirrus-qemu|qxl|vboxvideo|hyperv_drm) ;;
            virtio-pci)  # QEMU's virtio-gpu: feature bit 0 is VIRGL (3D)
                for v in "$dev"/virtio*; do
                    case $(cat "$v/features" 2>/dev/null) in 1*) return 1 ;; esac
                done ;;
            *) return 1 ;;  # a GPU driver: i915, amdgpu, nouveau, nvidia, vmwgfx, ...
        esac
    done
    [ "$found" = 1 ]
}
software_render && export NULLGRID_SOFTWARE_RENDER=1
# No render node at all (simpledrm/efifb): Sway uses its pixman renderer.
ls /dev/dri/renderD* >/dev/null 2>&1 || export WLR_RENDERER=pixman
export XDG_SESSION_TYPE=wayland
# The console login set these to the console variants of the apps; the desktop has the real thing.
unset STARSHIP_CONFIG YAZI_CONFIG_HOME

case ${1:-} in
    hyprland|sway) order=$1 ;;
    "") if [ "${NULLGRID_LITE:-0}" = 1 ]; then order="sway hyprland"; else order="hyprland sway"; fi
        [ "${WLR_RENDERER:-}" = pixman ] || order="$order sway-software" ;;
    *) echo "usage: nullgrid-session [hyprland|sway]" >&2; exit 2 ;;
esac

start() {
    case $1 in
        hyprland)
            command -v start-hyprland >/dev/null || return 127
            start-hyprland ;;
        sway)
            command -v sway >/dev/null || return 127
            # NVIDIA's proprietary driver works with Sway but needs the flag.
            unsupported=""
            [ -d /sys/module/nvidia ] && unsupported=--unsupported-gpu
            XDG_CURRENT_DESKTOP=sway XDG_SESSION_DESKTOP=sway sway $unsupported ;;
        sway-software)
            (export WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1; start sway) ;;
    esac
}

status_file=$state/session-status
: >"$status_file"
note() { echo "nullgrid-session: $*" >&2; echo "$(date '+%F %T') $*" >>"$status_file"; }

for name in $order; do
    log=$state/session-$name.log
    began=$(date +%s)
    start "$name" >"$log" 2>&1
    status=$?
    if [ $(( $(date +%s) - began )) -ge 10 ]; then
        if [ "$status" -eq 0 ]; then
            note "$name ran and was left normally"
            exit 0
        fi
        note "$name stopped with status $status (log: $log)"
        [ "$status" -eq 1 ] && exit 3 || exit "$status"
    fi
    note "$name could not start (quit after $(( $(date +%s) - began )) s with status $status, log: $log)"
done
note "no compositor could start; fell back to TTY mode"
exit 1
