/* Generated by nullgrid from qt6ct.qss.j2. Do not edit: changes are overwritten. */
/* Customize ~/.config/nullgrid/nullgrid.toml or override the template instead. */

QPushButton, QToolButton, QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
    border: 1px solid #304857;
    border-radius: 0px;
    background-color: #0f1824;
    color: #eef6ff;
    padding: 3px 8px;
}
QPushButton:hover, QToolButton:hover, QComboBox:hover { border-color: #8fd8ff; }
QPushButton:pressed, QPushButton:checked, QToolButton:checked {
    background-color: #293e4b;
    border-color: #8fd8ff;
    color: #8fd8ff;
}
QPushButton:default { border-color: #8fd8ff; }
QPushButton:disabled, QToolButton:disabled { color: #6b7d90; border-color: #2f3843; }
QToolButton { border-color: transparent; background-color: transparent; }
QLineEdit:focus, QSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus { border-color: #8fd8ff; }

QMenu, QToolTip {
    background-color: #0f1824;
    color: #eef6ff;
    border: 1px solid #4b7187;
    border-radius: 0px;
}
QMenu::item { padding: 4px 18px; }
QMenu::item:selected { background-color: #74afcf; color: #070a0f; }
QMenu::separator { height: 1px; background: #394450; margin: 4px 8px; }

QTabBar::tab { padding: 5px 14px; border: none; background: transparent; color: #6b7d90; }
QTabBar::tab:selected { color: #8fd8ff; border-bottom: 2px solid #8fd8ff; }
QTabBar::tab:hover { color: #eef6ff; }

QHeaderView::section {
    background-color: #0f1824;
    color: #8fd8ff;
    border: none;
    border-bottom: 1px solid #3d5c6f;
    padding: 4px 8px;
}

QProgressBar { border: 1px solid #3d5c6f; border-radius: 0px; text-align: center; background: #070a0f; }
QProgressBar::chunk { background-color: #8fd8ff; width: 6px; margin: 1px; }

QScrollBar:vertical { width: 8px; background: transparent; }
QScrollBar:horizontal { height: 8px; background: transparent; }
QScrollBar::handle { background: #4d5a69; border-radius: 0px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #8fd8ff; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QGroupBox { border: 1px solid #304857; border-radius: 0px; margin-top: 12px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; color: #8fd8ff; }
