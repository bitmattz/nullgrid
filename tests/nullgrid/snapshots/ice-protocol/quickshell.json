      "background": "#070a0f",
      "color0": "#141c28",
      "color1": "#ff5c7a",
      "color10": "#8ff0d8",
      "color11": "#ffdc8f",
      "color12": "#79a6ff",
      "color13": "#c3b2ff",
      "color14": "#bfe9ff",
      "color15": "#f7fbff",
      "color2": "#5fe0c0",
      "color3": "#ffc857",
      "color4": "#3d7bff",
      "color5": "#a58bff",
      "color6": "#8fd8ff",
      "color7": "#b4c4d6",
      "color8": "#3a4a5e",
      "color9": "#ff8aa0",
      "cursor": "#8fd8ff",
