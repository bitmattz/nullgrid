/* Generated by nullgrid from qt6ct.qss.j2. Do not edit: changes are overwritten. */
/* Customize ~/.config/nullgrid/nullgrid.toml or override the template instead. */

QPushButton, QToolButton, QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
    border: 1px solid #3a5115;
    border-radius: 0px;
    background-color: #10160d;
    color: #eaf5e0;
    padding: 3px 8px;
}
QPushButton:hover, QToolButton:hover, QComboBox:hover { border-color: #b6ff3b; }
QPushButton:pressed, QPushButton:checked, QToolButton:checked {
    background-color: #314412;
    border-color: #b6ff3b;
    color: #b6ff3b;
}
QPushButton:default { border-color: #b6ff3b; }
QPushButton:disabled, QToolButton:disabled { color: #6f7d66; border-color: #2f362c; }
QToolButton { border-color: transparent; background-color: transparent; }
QLineEdit:focus, QSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus { border-color: #b6ff3b; }

QMenu, QToolTip {
    background-color: #10160d;
    color: #eaf5e0;
    border: 1px solid #5e8220;
    border-radius: 0px;
}
QMenu::item { padding: 4px 18px; }
QMenu::item:selected { background-color: #93cd30; color: #050605; }
QMenu::separator { height: 1px; background: #3a4236; margin: 4px 8px; }

QTabBar::tab { padding: 5px 14px; border: none; background: transparent; color: #6f7d66; }
QTabBar::tab:selected { color: #b6ff3b; border-bottom: 2px solid #b6ff3b; }
QTabBar::tab:hover { color: #eaf5e0; }

QHeaderView::section {
    background-color: #10160d;
    color: #b6ff3b;
    border: none;
    border-bottom: 1px solid #4c6a1b;
    padding: 4px 8px;
}

QProgressBar { border: 1px solid #4c6a1b; border-radius: 0px; text-align: center; background: #050605; }
QProgressBar::chunk { background-color: #b6ff3b; width: 6px; margin: 1px; }

QScrollBar:vertical { width: 8px; background: transparent; }
QScrollBar:horizontal { height: 8px; background: transparent; }
QScrollBar::handle { background: #4f5949; border-radius: 0px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #b6ff3b; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QGroupBox { border: 1px solid #3a5115; border-radius: 0px; margin-top: 12px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; color: #b6ff3b; }
