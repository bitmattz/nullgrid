/* Generated by nullgrid from qt6ct.qss.j2. Do not edit: changes are overwritten. */
/* Customize ~/.config/nullgrid/nullgrid.toml or override the template instead. */

QPushButton, QToolButton, QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
    border: 1px solid #2e5053;
    border-radius: 0px;
    background-color: #24111a;
    color: #e6f7f7;
    padding: 3px 8px;
}
QPushButton:hover, QToolButton:hover, QComboBox:hover { border-color: #5ef2f2; }
QPushButton:pressed, QPushButton:checked, QToolButton:checked {
    background-color: #2b4548;
    border-color: #5ef2f2;
    color: #5ef2f2;
}
QPushButton:default { border-color: #5ef2f2; }
QPushButton:disabled, QToolButton:disabled { color: #7a8a8f; border-color: #403e42; }
QToolButton { border-color: transparent; background-color: transparent; }
QLineEdit:focus, QSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus { border-color: #5ef2f2; }

QMenu, QToolTip {
    background-color: #24111a;
    color: #e6f7f7;
    border: 1px solid #3c7e80;
    border-radius: 0px;
}
QMenu::item { padding: 4px 18px; }
QMenu::item:selected { background-color: #50c4c5; color: #1a0b0f; }
QMenu::separator { height: 1px; background: #4a4a4f; margin: 4px 8px; }

QTabBar::tab { padding: 5px 14px; border: none; background: transparent; color: #7a8a8f; }
QTabBar::tab:selected { color: #5ef2f2; border-bottom: 2px solid #5ef2f2; }
QTabBar::tab:hover { color: #e6f7f7; }

QHeaderView::section {
    background-color: #24111a;
    color: #5ef2f2;
    border: none;
    border-bottom: 1px solid #35676a;
    padding: 4px 8px;
}

QProgressBar { border: 1px solid #35676a; border-radius: 0px; text-align: center; background: #1a0b0f; }
QProgressBar::chunk { background-color: #5ef2f2; width: 6px; margin: 1px; }

QScrollBar:vertical { width: 8px; background: transparent; }
QScrollBar:horizontal { height: 8px; background: transparent; }
QScrollBar::handle { background: #5d6469; border-radius: 0px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #5ef2f2; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QGroupBox { border: 1px solid #2e5053; border-radius: 0px; margin-top: 12px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; color: #5ef2f2; }
