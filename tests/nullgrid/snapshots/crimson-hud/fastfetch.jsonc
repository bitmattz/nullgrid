// Generated by nullgrid from fastfetch.jsonc.j2. Do not edit: changes are overwritten.
// Customize ~/.config/nullgrid/nullgrid.toml or override the template instead.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/nullgrid/logo/nullgrid.txt",
    "color": { "1": "cyan", "2": "red" },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": " › ",
    "color": { "keys": "cyan", "title": "red", "separator": "white" },
    "key": { "width": 10 }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "separator", "string": "─" },
    { "type": "os", "key": "SYSTEM", "format": "{pretty-name} // {arch}" },
    { "type": "kernel", "key": "KERNEL" },
    { "type": "uptime", "key": "UPTIME" },
    { "type": "packages", "key": "PACKAGES" },
    { "type": "shell", "key": "SHELL" },
    { "type": "terminal", "key": "TERMINAL" },
    // no clock speed: the line then fits the login terminal
    { "type": "cpu", "key": "CPU", "format": "{name} ({cores-logical})" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "MEMORY" },
    { "type": "disk", "key": "DISK", "folders": "/" },
    { "type": "battery", "key": "POWER" },
    { "type": "localip", "key": "NETWORK" },
    "break",
    { "type": "colors", "symbol": "block" }
  ]
}
