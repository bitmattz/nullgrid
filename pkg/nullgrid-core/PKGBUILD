# NULLGRID theme engine and the `nullgrid` CLI, plus the theme presets and app templates.
# Sources come from the repo checkout: build/build-packages.sh drops nullgrid-src.tar here.
pkgname=nullgrid-core
pkgver=0.4.0
pkgrel=1
pkgdesc="NULLGRID theme engine and nullgrid command"
arch=('any')
url="https://github.com/bitmattz/nullgrid"
license=('MIT')
depends=('python' 'python-jinja' 'python-tomlkit')
optdepends=('librsvg: wallpaper as PNG (rsvg-convert)' 'swaybg: show the wallpaper')
makedepends=('python-build' 'python-installer' 'python-flit-core')
checkdepends=('python-pytest')
source=('nullgrid-src.tar')
sha256sums=('SKIP')

build() {
  cd tools/nullgrid
  python -m build --wheel --no-isolation
}

check() {
  python -c "import sys; sys.path.insert(0, 'tools/nullgrid'); import nullgrid; \
    assert nullgrid.__version__ == '$pkgver', 'pkgver and nullgrid.__version__ differ'"
  PYTHONDONTWRITEBYTECODE=1 python -m pytest -q -p no:cacheprovider tests/nullgrid
}

package() {
  (cd tools/nullgrid && python -m installer --destdir="$pkgdir" dist/*.whl)
  install -Dm644 -t "$pkgdir/usr/share/nullgrid/themes" themes/*.toml
  install -Dm644 -t "$pkgdir/usr/share/nullgrid/templates" config/templates/*
  install -Dm644 -t "$pkgdir/usr/share/nullgrid/keybinds" config/keybinds/*.toml
  install -Dm644 config/nullgrid.toml "$pkgdir/usr/share/nullgrid/nullgrid.toml"
}
