# Open-licensed UI fonts NULLGRID uses that Arch doesn't package: Rajdhani (UI) and Orbitron
# (display). Both SIL OFL 1.1, from Google Fonts' repository at a pinned commit.
# JetBrains Mono (terminal) comes from Arch's ttf-jetbrains-mono.
pkgname=nullgrid-fonts
pkgver=0.3.0
pkgrel=1
pkgdesc="NULLGRID UI fonts: Rajdhani and Orbitron (OFL)"
arch=('any')
url="https://github.com/google/fonts"
license=('OFL-1.1')
depends=('fontconfig')
_commit=66928797f271fed5ee428544e7229685e2d90127
_raw="https://raw.githubusercontent.com/google/fonts/$_commit/ofl"
source=("$_raw/rajdhani/Rajdhani-Light.ttf"
        "$_raw/rajdhani/Rajdhani-Regular.ttf"
        "$_raw/rajdhani/Rajdhani-Medium.ttf"
        "$_raw/rajdhani/Rajdhani-SemiBold.ttf"
        "$_raw/rajdhani/Rajdhani-Bold.ttf"
        "Rajdhani-OFL.txt::$_raw/rajdhani/OFL.txt"
        "Orbitron-wght.ttf::$_raw/orbitron/Orbitron%5Bwght%5D.ttf"
        "Orbitron-OFL.txt::$_raw/orbitron/OFL.txt")
sha256sums=('140e9f13af69538161c5780fcf7f81594c069aea887e7bffd417ae1c641213c3'
            '6e1fc228a8318251a6e569502ec57bac1e4656c582f92f59ccecc4688e039b98'
            '12ff7dcfe4c206e3875ac53b1762eab57de6a2fa7f5a86c26b97b88d6591eac2'
            '94bbd25a18ca665999feb05a537de9fd2b860dcfb78bbe9ca00270825bf235da'
            '691470dd3286a14e9677940d0bf75796179841ba5215cbda1a2c8910a3226afd'
            'f62ef357d3a1c3d27edd35a6e1ba350e8a8d13499797964eeadefbf0b3b15d1f'
            'f42db2dd16e642258e35782916eceb1dcdbea06fb958d77ad71dc5963587e8fd'
            'ab609b0e110d622435ff337cdf233288556e011bbf9bd0550be98846c0630819')

package() {
  install -Dm644 -t "$pkgdir/usr/share/fonts/nullgrid" Rajdhani-*.ttf Orbitron-wght.ttf
  install -Dm644 Rajdhani-OFL.txt "$pkgdir/usr/share/licenses/$pkgname/Rajdhani-OFL.txt"
  install -Dm644 Orbitron-OFL.txt "$pkgdir/usr/share/licenses/$pkgname/Orbitron-OFL.txt"
}
