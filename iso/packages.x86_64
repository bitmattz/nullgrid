# NULLGRID live ISO package list (x86_64).
# Every package carries a reason on the comment line above it.
# (mkarchiso keeps trailing spaces from inline comments, so don't put comments after a name.)
# Grouped by purpose; keep it minimal.

## Base system
# Arch base: glibc, systemd, pacman, coreutils...
base
# kernel
linux
# firmware for real hardware (wifi, GPUs) - old laptops need it
linux-firmware
# CPU microcode updates (Intel)
intel-ucode
# CPU microcode updates (AMD)
amd-ucode
# initramfs generator
mkinitcpio
# live-boot hooks for the initramfs
mkinitcpio-archiso
# BIOS bootloader for the ISO
syslinux

## Live session basics
# live user runs admin commands without a root login
sudo
# default shell
zsh
# pager for man pages and logs
less
# small fallback editor (neovim is the default)
nano

## Networking
# wired + wifi, nmcli/nmtui; later read by the status bar
networkmanager

## NULLGRID (built from pkg/ into the local [nullgrid] repo)
# branding: os-release, release info
nullgrid-base
# theme engine + `nullgrid` CLI (pulls in python, python-jinja, python-tomlkit)
nullgrid-core
# themed TTY dashboard and launcher (python-textual, python-psutil)
nullgrid-dash
# UI fonts not in Arch: Rajdhani, Orbitron (OFL)
nullgrid-fonts
# zsh setup, default dotfiles, ASCII logo; depends on the apps below
nullgrid-terminal
# desktop session: Hyprland/Sway defaults, nullgrid-session, wallpaper tools
nullgrid-desktop

## Terminal experience (also pulled in by nullgrid-terminal; listed so the ISO's contents are explicit)
# main terminal emulator (GPU-rendered, live config reload)
kitty
# terminal font (OFL)
ttf-jetbrains-mono
# Linux console font (has the box-drawing glyphs the TTY dashboard uses)
terminus-font
# fish-style suggestions in zsh
zsh-autosuggestions
# command highlighting in zsh
zsh-syntax-highlighting
# prompt with powerline-style segments
starship
# system info with the NULLGRID logo
fastfetch
# resource monitor
btop
# file manager
yazi
# editor (with the generated nullgrid colorscheme)
neovim
# git TUI
lazygit
# version control (lazygit needs it)
git
# audio visualizer
cava
# terminal multiplexer with the HUD status bar
tmux

## Desktop (also pulled in by nullgrid-desktop)
# main compositor: blur, glow, animations (Lua config)
hyprland
# fallback compositor (GPUs where Hyprland fails) and the [performance] lite session
sway
# draws the wallpaper on both compositors
swaybg
# rsvg-convert: renders the generated SVG wallpaper to PNG
librsvg
# desktop shell toolkit: bar, dock, HUD widgets, start menu, notifications (QML)
quickshell
# keyboard app launcher
fuzzel
# lock screen
hyprlock
# screenshots (nullgrid-screenshot): capture
grim
# screenshots: region selection
slurp
# clipboard (wl-copy/wl-paste); screenshots go to the clipboard too
wl-clipboard
# notify-send, for scripts that report to the notification daemon
libnotify
# screen brightness (keys and the bar), works without root through logind
brightnessctl
# OpenGL drivers, incl. llvmpipe for software rendering in VMs without 3D acceleration
mesa
