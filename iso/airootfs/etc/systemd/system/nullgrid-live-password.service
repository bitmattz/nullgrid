# Live ISO only: the live user's password is "nullgrid", so the lock screen (hyprlock) can be
# unlocked; the lock screen shows it (/etc/nullgrid/lock-hint). Login happens through autologin
# and sudo needs no password. (An empty password doesn't work: PAM then succeeds without asking,
# and hyprlock never unlocks.)
[Unit]
Description=Password for the NULLGRID live user
After=systemd-sysusers.service
Before=getty@tty1.service serial-getty@ttyS0.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo nullgrid:nullgrid | /usr/bin/chpasswd'

[Install]
WantedBy=multi-user.target
